# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Local configuration (contains machine-specific SDK path)
local.properties

# Signing keys — never commit these
*.keystore
# `debug.keystore` is deliberately NOT committed: the repo is public and this key is what the
# installer checks when applying an in-app update. CI restores it from the DEBUG_KEYSTORE_BASE64
# secret. For local builds, drop the same file at the project root once (ignored by this rule).
*.jks

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db
# Windows "downloaded from the internet" marker files (they break the resource merger)
*:Zone.Identifier

# Test report
TEST_REPORT.md

# Local agent state (session notes / scratch) - not part of the app
.workbuddy/
# Reverse-engineering scratch material (reference scripts + __pycache__)
.refs/

# Kotlin build cache
.kotlin/
