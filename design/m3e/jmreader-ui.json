    {
      "id": "reader",
      "name": "阅读器",
      "x": 1476,
      "y": 0,
      "note": "竖向连续阅读：整章页面一列到底，自动还原被打乱的页面，底部可切换上一话 / 下一话。"
    },
    {
      "id": "settings",
      "name": "设置",
      "x": 1968,
      "y": 0,
